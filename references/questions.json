{
  "version": "3.0",
  "title": "MDTI · 麦门点餐人格测试",
  "note": "每个轴 3 题，二选一，不可平票。选项尽量贴着十六型的台词写，让人一眼认领。",
  "axes": {
    "social": {
      "label": "独 / 群",
      "desc": "你的能量来自一个人，还是一桌人",
      "poles": { "独": "S", "群": "G" }
    },
    "novelty": {
      "label": "稳 / 新",
      "desc": "你信老几样，还是信「新品」两个字",
      "poles": { "稳": "F", "新": "N" }
    },
    "basis": {
      "label": "算 / 感",
      "desc": "你靠算账，还是靠那一下",
      "poles": { "算": "C", "感": "V" }
    },
    "restraint": {
      "label": "控 / 纵",
      "desc": "你收着，还是放开",
      "poles": { "控": "R", "纵": "I" }
    }
  },
  "questions": [
    {
      "id": 1,
      "axis": "social",
      "text": "中午只有 45 分钟，你的理想吃法是？",
      "options": [
        { "key": "A", "text": "一个人，耳机一戴，吃完就走", "pole": "独" },
        { "key": "B", "text": "拉上一个人，边吃边聊，时间不重要", "pole": "群" }
      ]
    },
    {
      "id": 2,
      "axis": "social",
      "text": "点单的时候，你最怕听到哪一句？",
      "options": [
        { "key": "A", "text": "「你随便点」——那我点什么你都得吃", "pole": "独" },
        { "key": "B", "text": "「你定吧，我们都行」——十个人的单让我定", "pole": "群" }
      ]
    },
    {
      "id": 3,
      "axis": "social",
      "text": "吃到一样特别好吃的东西，你会？",
      "options": [
        { "key": "A", "text": "记下来，下次自己再来", "pole": "独" },
        { "key": "B", "text": "发到群里：「下次一起去」", "pole": "群" }
      ]
    },
    {
      "id": 4,
      "axis": "novelty",
      "text": "菜单上出现「新品」两个字。",
      "options": [
        { "key": "A", "text": "看一眼，然后还是点老样子", "pole": "稳" },
        { "key": "B", "text": "手已经点上去了", "pole": "新" }
      ]
    },
    {
      "id": 5,
      "axis": "novelty",
      "text": "店员说「这款今天是最后一天」。",
      "options": [
        { "key": "A", "text": "哦，那下次见", "pole": "稳" },
        { "key": "B", "text": "那必须来一个", "pole": "新" }
      ]
    },
    {
      "id": 6,
      "axis": "novelty",
      "text": "你更愿意？",
      "options": [
        { "key": "A", "text": "把一样东西吃到闭着眼都能点", "pole": "稳" },
        { "key": "B", "text": "把菜单上没吃过的都划掉一遍", "pole": "新" }
      ]
    },
    {
      "id": 7,
      "axis": "basis",
      "text": "看到「第二份半价」。",
      "options": [
        { "key": "A", "text": "先算单价实际降了多少", "pole": "算" },
        { "key": "B", "text": "半价？不买亏了", "pole": "感" }
      ]
    },
    {
      "id": 8,
      "axis": "basis",
      "text": "两个套餐差 3 块：一个多一块鸡翅，一个多一杯可乐。",
      "options": [
        { "key": "A", "text": "你会算哪个更值", "pole": "算" },
        { "key": "B", "text": "你选当下更想吃的那个", "pole": "感" }
      ]
    },
    {
      "id": 9,
      "axis": "basis",
      "text": "拿到餐之后。",
      "options": [
        { "key": "A", "text": "先核对小票，看看券有没有用对", "pole": "算" },
        { "key": "B", "text": "拿了就走，吃就完了", "pole": "感" }
      ]
    },
    {
      "id": 10,
      "axis": "restraint",
      "text": "点单之前，你会先看热量吗？",
      "options": [
        { "key": "A", "text": "会，心里大概有个数", "pole": "控" },
        { "key": "B", "text": "不看，好吃就行", "pole": "纵" }
      ]
    },
    {
      "id": 11,
      "axis": "restraint",
      "text": "一份套餐吃完，你说的通常是？",
      "options": [
        { "key": "A", "text": "「够了够了」", "pole": "控" },
        { "key": "B", "text": "「再来一份」", "pole": "纵" }
      ]
    },
    {
      "id": 12,
      "axis": "restraint",
      "text": "一桌人都点了大份，你？",
      "options": [
        { "key": "A", "text": "「我少一点」", "pole": "控" },
        { "key": "B", "text": "「那我也要大的」", "pole": "纵" }
      ]
    }
  ]
}
